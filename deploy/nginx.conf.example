# Exemple nginx pour Hakim Travels (à adapter : domaine, chemins des certificats).
# Un seul processus Node écoute sur 127.0.0.1:3000 (voir .env : HOST=127.0.0.1, PORT=3000, TRUST_PROXY=1).

server {
    listen 80;
    listen [::]:80;
    server_name www.exemple.ma exemple.ma;
    return 301 https://www.exemple.ma$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name exemple.ma;

    ssl_certificate     /etc/letsencrypt/live/www.exemple.ma/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.exemple.ma/privkey.pem;
    return 301 https://www.exemple.ma$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.exemple.ma;

    # TLS : certificats Let's Encrypt (certbot) ou ceux de l'hébergeur.
    ssl_certificate     /etc/letsencrypt/live/www.exemple.ma/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.exemple.ma/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Doit rester >= MAX_UPLOAD_MB du .env (8 Mo par défaut) : sinon les téléversements d'images échouent.
    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;  # écrase la valeur client : le rate-limit admin en dépend
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 60s;
    }
}
